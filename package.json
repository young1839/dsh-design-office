{
  "name": "@young1839/dsh-design-office",
  "version": "0.1.1",
  "description": "Design-enhanced Office document tools for DeepSeek Harness: generate/edit/read PPT, PDF, Word, Excel with gradient backgrounds, icon assets, illustration covers, and template system (auto-search assets when user provides none).",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "skills",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node tests/tool-registration-check.mjs && node tests/version-compat.mjs",
    "test:compat": "node tests/version-compat.mjs",
    "test:all": "npm test && node tests/bug-check.mjs && node tests/bug-check2.mjs && node tests/e2e-m1.mjs && node tests/e2e-m2.mjs && node tests/e2e-m3.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "office",
    "pptx",
    "pdf",
    "docx",
    "xlsx",
    "design",
    "cordis"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.15.0",
    "pptxgenjs": "^3.12.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
